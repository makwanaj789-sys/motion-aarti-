{
  "name": "gpt-astra-concept",
  "private": true,
  "version": "1.0.0",
  "description": "Fan-made 'GPT Astra 6' ChatGPT concept promo, 1920x1080 @ 60 fps (Remotion). Main composition: AstraRef.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "audio:ref": "scripts/extract_audio.sh",
    "render": "remotion render src/index.ts AstraRef out/GPT_Astra_6_Concept_RefAudio_1920x1080_60fps.mp4 --codec=h264 --crf=14 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=256k --concurrency=4",
    "audio:v1": "python3 audio/make_audio.py public/audio/score.wav",
    "render:v1": "remotion render src/index.ts AstraPromo out/GPT_Astra_6_Concept_1920x1080_60fps.mp4 --codec=h264 --crf=14 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=256k --concurrency=4"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@remotion/bundler": "^4.0.534",
    "@remotion/cli": "^4.0.534",
    "@remotion/motion-blur": "^4.0.534",
    "@remotion/renderer": "^4.0.534",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.534",
    "typescript": "^7.0.2"
  }
}
